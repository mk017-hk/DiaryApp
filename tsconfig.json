{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    // TypeScript 6 no longer pulls in every @types package automatically, so
    // Jest's globals have to be requested explicitly. Library types that are
    // imported (React, Expo) resolve through imports and need no entry here.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/design": ["./src/design"],
      "@/design/*": ["./src/design/*"],
      "@/components": ["./src/components"],
      "@/components/*": ["./src/components/*"],
      "@/features/*": ["./src/features/*"],
      "@/services/*": ["./src/services/*"],
      "@/hooks": ["./src/hooks"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib": ["./src/lib"],
      "@/lib/*": ["./src/lib/*"],
      "@/types": ["./src/types"],
      "@/types/*": ["./src/types/*"],
      "@/validation/*": ["./src/validation/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "build", ".expo"]
}
