# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit real values.
#
# Only the anon/publishable key belongs in the mobile app. It is safe to ship
# because every table is protected by Row Level Security. The service role key
# bypasses RLS entirely and must never appear in this project's client code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
