# Copy to `.env.local` and fill in. `.env*` is gitignored — never commit real values.
#
# Only the anon/publishable key belongs in the mobile app. It is safe to ship
# because every table is protected by Row Level Security. The service role key
# bypasses RLS entirely and must never appear in this project's client code.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# For the local stack, take both from `npx supabase status`. On a phone or in a
# cloud container the URL cannot be 127.0.0.1 — that address means the device
# itself — so use the machine's LAN address or a tunnel.
#
# Leaving these unset is fine. The app detects it, keeps entries on the device
# and skips the sign-in screen entirely, which is how it runs in Expo Go with
# no backend at all.
